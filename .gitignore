# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.hypothesis/
.mypy_cache/
.pyright/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Build artifacts
build/
dist/
*.whl
*.tar.gz

# Virtual environments
.venv/
venv/
env/

# Secrets / instance config (never committed)
.env
.env.*
!.env.example
*.pem
*.key

# Node / JS (packages/aethercal-ui/js) — never commit node_modules or transient build output
node_modules/
*.tsbuildinfo
packages/aethercal-ui/js/dist/
# The built calendar bundle (src/aethercal/ui/assets/aethercal-calendar.js) IS committed on
# purpose: ~3 KB, reproducible via `pnpm build`, and it must be present at import time (rx.asset()
# validates it) for a fresh clone / CI / `pip install` to work with no Node toolchain.

# Reflex build output
.web/

# examples/demo public assets (E-01, extended for the I-1 landing-polish fix): the source of
# truth is the base64 sidecar under assets-src/ (plain text, safe for every publishing path),
# decoded to real binary files by scripts/decode-assets.mjs as a build/dev step. The decoded
# binaries are reproducible and must not be committed. og.png used to be the one hand-authored
# exception here — it joined the same sidecar pipeline once it needed a real content update
# (stale "FOUR VIEWS" copy) and hand-committing a raw PNG through the GitHub Contents API (the
# MCP publishing path for this branch) turned out to corrupt binary content the same way a raw
# .webp would.
packages/aethercal-ui/js/examples/demo/public/screenshot-calendar.webp
packages/aethercal-ui/js/examples/demo/public/screenshot-live-booking.webp
packages/aethercal-ui/js/examples/demo/public/og.png

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
# Crisol (internal cross-review tooling): its logs carry local paths and the engine's
# name, and NOTHING internal belongs in a public repo. A pattern, not a list of the
# names we happened to see: `.crisol-reviewed` alone let five `.log` files through.
.crisol-*

# FastHTML's session-cookie SIGNING KEY (fasthtml/core.py::get_key, default key_fname).
# It is generated per deployment and read from disk when the app does not pass
# `secret_key=`. Committing it publishes the key that signs every session cookie the
# booking app issues. It was tracked and PUBLIC until 2026-07-16.
.sesskey
